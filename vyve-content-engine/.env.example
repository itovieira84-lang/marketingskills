# Copie para .env (nunca versione o .env). Segredos ficam só aqui ou no gerenciador do servidor.

# Banco (Postgres local ou Supabase). O app conecta com um papel SEM privilégio de dono (vyve_login),
# para que o RLS valha de verdade. A URL de admin só é usada para rodar migrações.
DATABASE_URL=postgres://vyve_login:TROQUE@localhost:5432/vyve
DATABASE_ADMIN_URL=postgres://postgres:TROQUE@localhost:5432/vyve

# Assina cookies de sessão e URLs públicas de mídia. Mínimo 32 caracteres aleatórios.
VYVE_SESSION_SECRET=

# IA. Sem chave, o modo padrão é "claude-code" (os subagentes respondem as tarefas).
# ANTHROPIC_API_KEY=
# VYVE_LLM_MODE=anthropic        # anthropic | claude-code | fixture (fixture = teste fictício)
# VYVE_MODEL=claude-opus-5-5
# VYVE_BULK_MODEL=claude-opus-5-5 # modelo dos roteiros em volume; trocar por um mais barato é decisão sua
# VYVE_MAX_RPM=20
# VYVE_RESEARCH_MAX_SEARCHES=8

# Transcrição local (opcional): pip install faster-whisper "av<16"
# VYVE_TRANSCRIBER=faster-whisper
# VYVE_PYTHON=python3
# VYVE_WHISPER_MODEL=small
# VYVE_WHISPER_LANG=pt

# Publicação oficial no Instagram (só depois do app da Meta aprovado).
# O token de cada cliente vai numa variável própria; no painel você informa só o NOME dela.
# IG_TOKEN_CLIENTE_X=
# IG_GRAPH_VERSION=v23.0
# URL pública do painel, de onde a Meta baixa as mídias aprovadas (/api/public-media, assinada).
# VYVE_PUBLIC_BASE_URL=https://painel.suaagencia.com
# VYVE_PANEL_URL=https://painel.suaagencia.com

# Mídia
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# REMOTION_BROWSER_EXECUTABLE=     # Chrome headless; vazio = Remotion baixa o dele
# VYVE_RENDER_CONCURRENCY=2
# VYVE_STORAGE_DIR=storage
# VYVE_MAX_UPLOAD_MB=500

# CLI (comandos que agem como um usuário)
# VYVE_CLI_EMAIL=
# VYVE_CLI_PASSWORD=
