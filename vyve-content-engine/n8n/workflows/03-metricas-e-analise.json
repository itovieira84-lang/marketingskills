      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "VYVE_API",
          "name": "VYVE API (Authorization: Bearer ...)"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.base_url }}/api/v1/metrics/collect",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "d504ae2f-5068-4af1-9782-ddde49ac3e84",
